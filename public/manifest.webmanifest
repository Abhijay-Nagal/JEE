    { "name": "Mock Test", "short_name": "Mock", "url": "./index.html#/mock", "description": "Timed test with negative marking" },
    { "name": "Progress", "short_name": "Progress", "url": "./index.html#/progress", "description": "Your analytics" }
  ]
